{% doc %}
  @prompt
    SLIDER
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-slider-{{ ai_gen_id }} .ai-slider__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .ai-slider-{{ ai_gen_id }} .ai-slider__track::-webkit-scrollbar { display: none; }
  .ai-slider-{{ ai_gen_id }} .ai-slider__slide {
    position: relative;
    flex: 0 0 100%;
    min-width: 0;
    min-height: {{ block.settings.slide_height }}px;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }
  .ai-slider-{{ ai_gen_id }} .ai-slider__image,
  .ai-slider-{{ ai_gen_id }} .ai-slider__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ai-slider-{{ ai_gen_id }} .ai-slider__image { object-fit: cover; }
  .ai-slider-{{ ai_gen_id }} .ai-slider__placeholder svg { width: 100%; height: 100%; object-fit: cover; background: #272c32; }
  .ai-slider-{{ ai_gen_id }} .ai-slider__shade {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
  }
  .ai-slider-{{ ai_gen_id }} .ai-slider__content {
    position: relative;
    z-index: 1;
    width: min(760px, 90%);
    padding: 32px 18px;
  }
  .ai-slider-{{ ai_gen_id }} .ai-slider__heading {
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
    font-size: clamp(28px, 5vw, {{ block.settings.heading_size }}px);
    line-height: 1.1;
  }
  .ai-slider-{{ ai_gen_id }} .ai-slider__copy { margin: 0 auto 22px; max-width: 620px; line-height: 1.55; }
  .ai-slider-{{ ai_gen_id }} .ai-slider__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 24px;
    border: 1px solid {{ block.settings.button_background }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text }};
    text-decoration: none;
  }
  .ai-slider-{{ ai_gen_id }} .ai-slider__link:focus-visible,
  .ai-slider-{{ ai_gen_id }} .ai-slider__arrow:focus-visible,
  .ai-slider-{{ ai_gen_id }} .ai-slider__dot:focus-visible { outline: 3px solid {{ block.settings.text_color }}; outline-offset: 3px; }
  .ai-slider-{{ ai_gen_id }} .ai-slider__controls {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    pointer-events: none;
  }
  .ai-slider-{{ ai_gen_id }} .ai-slider__arrow,
  .ai-slider-{{ ai_gen_id }} .ai-slider__dot { pointer-events: auto; cursor: pointer; }
  .ai-slider-{{ ai_gen_id }} .ai-slider__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255,255,255,.75);
    border-radius: 50%;
    background: rgba(0,0,0,.55);
    color: #fff;
    font-size: 23px;
    line-height: 1;
  }
  .ai-slider-{{ ai_gen_id }} .ai-slider__arrow--prev { left: 14px; }
  .ai-slider-{{ ai_gen_id }} .ai-slider__arrow--next { right: 14px; }
  .ai-slider-{{ ai_gen_id }} .ai-slider__dot {
    width: 11px;
    height: 11px;
    padding: 0;
    border: 1px solid #fff;
    border-radius: 50%;
    background: transparent;
  }
  .ai-slider-{{ ai_gen_id }} .ai-slider__dot[aria-current="true"] { background: #fff; }
  @media (max-width: 749px) {
    .ai-slider-{{ ai_gen_id }} { width: 100%; }
    .ai-slider-{{ ai_gen_id }} .ai-slider__slide { min-height: {{ block.settings.mobile_height }}px; }
    .ai-slider-{{ ai_gen_id }} .ai-slider__arrow { width: 36px; height: 36px; }
    .ai-slider-{{ ai_gen_id }} .ai-slider__arrow--prev { left: 8px; }
    .ai-slider-{{ ai_gen_id }} .ai-slider__arrow--next { right: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-slider-{{ ai_gen_id }} .ai-slider__track { scroll-behavior: auto; }
  }
{% endstyle %}

<ai-slider-{{ ai_gen_id }} class="ai-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-slider__track" id="ai-slider-track-{{ ai_gen_id }}" tabindex="0" aria-label="{{ block.settings.slider_label | escape }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'slide_' | append: i | append: '_image'
        assign heading_key = 'slide_' | append: i | append: '_heading'
        assign text_key = 'slide_' | append: i | append: '_text'
        assign link_key = 'slide_' | append: i | append: '_link'
        assign label_key = 'slide_' | append: i | append: '_button_label'
        assign slide_image = block.settings[image_key]
        assign slide_heading = block.settings[heading_key]
        assign slide_text = block.settings[text_key]
        assign slide_link = block.settings[link_key]
        assign slide_button_label = block.settings[label_key]
      %}
      {% if slide_image != blank or slide_heading != blank or slide_text != blank %}
        <article class="ai-slider__slide" aria-label="{{ forloop.index }}">
          {% if slide_image != blank %}
            <img class="ai-slider__image" src="{{ slide_image | image_url: width: 2000 }}" alt="{{ slide_image.alt | escape }}" loading="lazy" width="{{ slide_image.width }}" height="{{ slide_image.height }}">
          {% else %}
            <div class="ai-slider__placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}</div>
          {% endif %}
          <div class="ai-slider__shade"></div>
          <div class="ai-slider__content">
            {% if slide_heading != blank %}<h2 class="ai-slider__heading">{{ slide_heading | escape }}</h2>{% endif %}
            {% if slide_text != blank %}<div class="ai-slider__copy">{{ slide_text | escape | newline_to_br }}</div>{% endif %}
            {% if slide_link != blank and slide_button_label != blank %}<a class="ai-slider__link" href="{{ slide_link }}">{{ slide_button_label | escape }}</a>{% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>
  <button class="ai-slider__arrow ai-slider__arrow--prev" type="button" aria-label="Diapositiva anterior">‹</button>
  <button class="ai-slider__arrow ai-slider__arrow--next" type="button" aria-label="Diapositiva siguiente">›</button>
  <div class="ai-slider__controls" aria-label="Seleccionar diapositiva"></div>
</ai-slider-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'ai-slider-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class AiSlider extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.ai-slider__track');
        this.slides = Array.from(this.track.querySelectorAll('.ai-slider__slide'));
        this.controls = this.querySelector('.ai-slider__controls');
        this.prev = this.querySelector('.ai-slider__arrow--prev');
        this.next = this.querySelector('.ai-slider__arrow--next');
        if (this.slides.length < 2) {
          this.prev.hidden = true;
          this.next.hidden = true;
          return;
        }
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'ai-slider__dot';
          dot.setAttribute('aria-label', `Ir a la diapositiva ${index + 1}`);
          dot.setAttribute('aria-current', index === 0 ? 'true' : 'false');
          dot.addEventListener('click', () => this.goTo(index));
          this.controls.appendChild(dot);
        });
        this.prev.addEventListener('click', () => this.goTo(this.activeIndex() - 1));
        this.next.addEventListener('click', () => this.goTo(this.activeIndex() + 1));
        this.track.addEventListener('scroll', () => this.updateDots(), { passive: true });
        this.track.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') this.goTo(this.activeIndex() - 1);
          if (event.key === 'ArrowRight') this.goTo(this.activeIndex() + 1);
        });
      }
      activeIndex() {
        return Math.round(this.track.scrollLeft / this.track.clientWidth);
      }
      goTo(index) {
        const target = (index + this.slides.length) % this.slides.length;
        this.track.scrollTo({ left: this.slides[target].offsetLeft, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        this.updateDots();
      }
      updateDots() {
        const current = this.activeIndex();
        this.controls.querySelectorAll('.ai-slider__dot').forEach((dot, index) => dot.setAttribute('aria-current', index === current ? 'true' : 'false'));
      }
    }
    customElements.define(tagName, AiSlider);
  })();
</script>

{% schema %}
{
  "name": "Image slider",
  "settings": [
    { "type": "text", "id": "slider_label", "label": "Accessible label", "default": "Promotional slides" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "slide_height", "label": "Desktop height", "min": 250, "max": 700, "step": 25, "unit": "px", "default": 500 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 200, "max": 600, "step": 20, "unit": "px", "default": 380 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#1A1B18" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#FFFFFF" },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 40 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "header", "content": "Slide 1" },
    { "type": "image_picker", "id": "slide_1_image", "label": "Image" },
    { "type": "text", "id": "slide_1_heading", "label": "Heading", "default": "Discover something new" },
    { "type": "textarea", "id": "slide_1_text", "label": "Text", "default": "Add a short message to introduce this slide." },
    { "type": "url", "id": "slide_1_link", "label": "Button link" },
    { "type": "text", "id": "slide_1_button_label", "label": "Button label", "default": "Shop now" },
    { "type": "header", "content": "Slide 2" },
    { "type": "image_picker", "id": "slide_2_image", "label": "Image" },
    { "type": "text", "id": "slide_2_heading", "label": "Heading", "default": "A second feature" },
    { "type": "textarea", "id": "slide_2_text", "label": "Text", "default": "Show another collection, offer, or announcement." },
    { "type": "url", "id": "slide_2_link", "label": "Button link" },
    { "type": "text", "id": "slide_2_button_label", "label": "Button label", "default": "Explore" },
    { "type": "header", "content": "Slide 3" },
    { "type": "image_picker", "id": "slide_3_image", "label": "Image" },
    { "type": "text", "id": "slide_3_heading", "label": "Heading", "default": "More to explore" },
    { "type": "textarea", "id": "slide_3_text", "label": "Text", "default": "Complete your slider with one more highlight." },
    { "type": "url", "id": "slide_3_link", "label": "Button link" },
    { "type": "text", "id": "slide_3_button_label", "label": "Button label", "default": "Learn more" }
  ],
  "presets": [{ "name": "Image slider" }],
  "tag": null,
  "class": "image-slider-block"
}
{% endschema %}