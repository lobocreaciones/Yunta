{%- liquid
  assign body_font_bold = settings.type_body_font | font_modify: 'weight', '600'
  assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
  assign header_font_bold = settings.type_header_font | font_modify: 'weight', '600'
  # The nav bold option rides the 600 cut these fonts already load for strong
  # text — no extra font request. Families without a 600 cut render as auto.
  assign nav_font_bold = body_font_bold
  if settings.type_navigation_font == 'heading'
    assign nav_font_bold = header_font_bold
  endif
  assign button_font_baseline = settings.type_header_font.baseline_ratio | times: 10 | round
  if settings.type_button_font == 'body'
    assign button_font_baseline = settings.type_body_font.baseline_ratio | times: 10 | round
  endif

  assign color_background_dark = settings.colors_background | color_lighten: 8
  assign color_background_brightness = settings.colors_background | color_brightness | round
  if color_background_brightness > 125
    assign color_background_dark = settings.colors_background | color_darken: 8
  endif

  if color_background_brightness > 125
    assign color_border_strong = settings.colors_border | color_darken: 28
  else
    assign color_border_strong = settings.colors_border | color_lighten: 28
  endif
%}
{%- style -%}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  {{ body_font_italic | font_face: font_display: 'swap' }}
  {{ body_font_bold_italic | font_face: font_display: 'swap' }}
  {{ settings.type_header_font | font_face: font_display: 'swap' }}
  {{ header_font_bold | font_face: font_display: 'swap' }}

  :root {
    --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body-style: {{ settings.type_body_font.style }};
    --font-body-weight: {{ settings.type_body_font.weight }};

    --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    --font-heading-style: {{ settings.type_header_font.style }};
    --font-heading-weight: {{ settings.type_header_font.weight }};

    --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
    --font-heading-scale: {{ settings.heading_scale | times: 1.0 | divided_by: settings.body_scale }};

    {%- if settings.heading_size_mode == 'fluid' %}
    --font-h0-size: clamp(4rem, 2.7rem + 4vw, 6.4rem);
    --font-h1-size: clamp(3.2rem, 2.4rem + 2.5vw, 5rem);
    --font-h2-size: clamp(2.4rem, 1.95rem + 1.5vw, 3.5rem);
    --font-h3-size: clamp(1.8rem, 1.65rem + 0.55vw, 2.2rem);
    --font-h4-size: clamp(1.6rem, 1.55rem + 0.2vw, 2rem);
    --font-h5-size: 1.6rem;
    {%- else %}
    --font-h0-size: 3.6rem;
    --font-h1-size: 2.8rem;
    --font-h2-size: 2rem;
    --font-h3-size: 1.7rem;
    --font-h4-size: 1.5rem;
    --font-h5-size: 1.2rem;
    {%- endif %}

    --font-navigation-family: var(--font-{{ settings.type_navigation_font }}-family);
    --font-navigation-size: {{ settings.type_navigation_size }}px;
    --font-navigation-weight: var(--font-{{ settings.type_navigation_font }}-weight);
    --font-button-family: var(--font-{{ settings.type_button_font }}-family);
    --font-button-size: {{ settings.type_button_size }}px;
    --font-button-baseline: {% if button_font_baseline >= 2 %}{{ button_font_baseline | divided_by: 10.0 }}{% else %}0{% endif %}rem;
    --font-price-family: var(--font-{{ settings.type_price_font }}-family);
    --font-price-scale: var(--font-{{ settings.type_price_font }}-scale);

    --badge-radius: {% if settings.badge_shape == 'pill' %}999px{% else %}min(var(--button-radius), 0.2rem){% endif %};
    --badge-rotate: {{ settings.badge_rotate | default: 0 }}deg;

    --color-base-text: {{ settings.colors_text.red }}, {{ settings.colors_text.green }}, {{ settings.colors_text.blue }};
    --color-base-background: {{ settings.colors_background.red }}, {{ settings.colors_background.green }}, {{ settings.colors_background.blue }};
    --color-base-solid-button-labels: {{ settings.colors_solid_button_labels.red }}, {{ settings.colors_solid_button_labels.green }}, {{ settings.colors_solid_button_labels.blue }};
    --color-base-outline-button-labels: {{ settings.colors_outline_button_labels.red }}, {{ settings.colors_outline_button_labels.green }}, {{ settings.colors_outline_button_labels.blue }};
    --color-base-accent: {{ settings.colors_accent.red }}, {{ settings.colors_accent.green }}, {{ settings.colors_accent.blue }};
    --color-base-heading: {{ settings.colors_heading.red }}, {{ settings.colors_heading.green }}, {{ settings.colors_heading.blue }};
    --color-base-border: {{ settings.colors_border.red }}, {{ settings.colors_border.green }}, {{ settings.colors_border.blue }};
    --color-base-border-strong: {{ color_border_strong.red }}, {{ color_border_strong.green }}, {{ color_border_strong.blue }};
    --color-placeholder: {{ settings.colors_img_background.red }}, {{ settings.colors_img_background.green }}, {{ settings.colors_img_background.blue }};
    --color-overlay: {{ settings.colors_overlay.red }}, {{ settings.colors_overlay.green }}, {{ settings.colors_overlay.blue }};
    --color-keyboard-focus: {{ settings.colors_keyboard_focus.red }}, {{ settings.colors_keyboard_focus.green }}, {{ settings.colors_keyboard_focus.blue }};
    --color-shadow: {{ settings.colors_shadow.red }}, {{ settings.colors_shadow.green }}, {{ settings.colors_shadow.blue }};
    --shadow-opacity: 1;

    --color-background-dark: {{ color_background_dark.red }}, {{ color_background_dark.green }}, {{ color_background_dark.blue }};
    --color-price: {{ settings.colors_price }};
    --color-sale-price: {{ settings.colors_sale_price }};
    --color-sale-badge-background: {{ settings.colors_sale_badge_background }};
    --color-reviews: {{ settings.colors_reviews }};
    --color-critical: #c0270b;
    --color-success: #1f7a3a;

    --color-accent-strong: 184, 132, 26;
    --color-surface-warm: 251, 247, 241;
    --color-surface-card: 239, 230, 220;
    --color-warning: 168, 107, 0;
    --color-error: 192, 39, 11;
    --color-info: 26, 100, 240;
    --color-highlight: {{ settings.colors_highlight.red }}, {{ settings.colors_highlight.green }}, {{ settings.colors_highlight.blue }};

    --payment-terms-background-color: {{ settings.colors_background }};
    --page-width: {{ settings.page_width | divided_by: 10 }}rem;
    --page-width-margin: {% if settings.page_width == '1600' %}2{% else %}0{% endif %}rem;

    --card-color-scheme: var(--color-placeholder);
    --card-text-alignment: {{ settings.card_text_alignment }};
    --card-flex-alignment: {% if settings.card_text_alignment == 'center' %}center{% else %}flex-{{ settings.card_text_alignment }}{% endif %};
    --card-image-padding: {{ settings.card_image_padding }}px;
    --card-border-width: {{ settings.card_border_thickness }}px;
    --card-radius: {{ settings.card_corner_radius }}px;
    --card-shadow-horizontal-offset: {{ settings.card_shadow_horizontal_offset }}px;
    --card-shadow-vertical-offset: {{ settings.card_shadow_vertical_offset }}px;
    
    --button-radius: {{ settings.button_corner_radius }}px;
    --button-border-width: {{ settings.button_border_thickness }}px;
    --button-shadow-horizontal-offset: {{ settings.button_shadow_horizontal_offset }}px;
    --button-shadow-vertical-offset: {{ settings.button_shadow_vertical_offset }}px;

    --spacing-sections-desktop: {{ settings.spacing_sections }}px;
    --spacing-sections-mobile: {% if settings.spacing_sections < 24 %}{{ settings.spacing_sections }}{% else %}{{ settings.spacing_sections | times: 0.7 | round | at_least: 20 }}{% endif %}px;

    --gradient-free-ship-progress: {% if settings.colors_free_ship_progress != blank %}{{ settings.colors_free_ship_progress }}{% else %}linear-gradient(325deg,#F9423A 0,#F1E04D 100%){% endif %};
    --gradient-free-ship-complete: {% if settings.colors_free_ship_complete != blank %}{{ settings.colors_free_ship_complete }}{% else %}linear-gradient(325deg, #049cff 0, #35ee7a 100%){% endif %};

    --plabel-price-tag-color: #000000;
    --plabel-price-tag-background: #d1d5db;
    --plabel-price-tag-height: 2.5rem;

    --swatch-outline-color: #f4f6f8;

    {%- assign type_body_size_px = settings.body_scale | divided_by: 100.0 | times: 16.0 -%}
    --text-8xl: {{ type_body_size_px | plus: 80 | divided_by: 16.0 }}rem;
    --text-6xl: {{ type_body_size_px | plus: 44 | divided_by: 16.0 }}rem;
    --text-5xl: {{ type_body_size_px | plus: 32 | divided_by: 16.0 }}rem;
    --text-4xl: {{ type_body_size_px | plus: 20 | divided_by: 16.0 }}rem;
    --text-3xl: {{ type_body_size_px | plus: 14 | divided_by: 16.0 }}rem;
    --text-2xl: {{ type_body_size_px | plus: 8 | divided_by: 16.0 }}rem;
    --text-xl: {{ type_body_size_px | plus: 4 | divided_by: 16.0 }}rem;
    --text-lg: {{ type_body_size_px | plus: 2 | divided_by: 16.0 }}rem;
    --text-base: {{ type_body_size_px | divided_by: 16.0 }}rem;
    --text-2sm: {{ type_body_size_px | minus: 3 | at_least: 12 | divided_by: 16.0 }}rem;
    --text-sm: {{ type_body_size_px | minus: 2 | at_least: 12 | divided_by: 16.0 }}rem;
    --text-xs: {{ type_body_size_px | minus: 4 | at_least: 11 | divided_by: 16.0 }}rem;
    --text-3xs: {{ type_body_size_px | minus: 6 | at_least: 9 | divided_by: 16.0 }}rem;

    --fluid-sm-to-base: clamp(var(--text-sm), 0.8115rem + 0.1587vw, var(--text-base));
    --fluid-sm-to-lg: clamp(var(--text-sm), 0.748rem + 0.3174vw, var(--text-lg));
    --fluid-base-to-xl: clamp(var(--text-base), 0.873rem + 0.3175vw, var(--text-xl));
    --fluid-base-to-2xl: clamp(var(--text-base), 0.746rem + 0.6349vw, var(--text-2xl));
    --fluid-lg-to-2xl: clamp(var(--text-lg), 0.9722rem + 0.4444vw, var(--text-2xl));
    --fluid-xl-to-3xl: clamp(var(--text-xl), 0.4966rem + 1.1818vw, var(--text-3xl));

    --tw-translate-x: 0;
    --tw-translate-y: 0;
    --tw-rotate: 0;
    --tw-skew-x: 0;
    --tw-skew-y: 0;
    --tw-scale-x: 1;
    --tw-scale-y: 1;

    --font-normal: 400;
    --font-medium: 500;
    --font-bold: 700;

    --sp-0d5: 0.125rem;
    --sp-1: 0.25rem;
    --sp-1d5: 0.375rem;
    --sp-2: 0.5rem;
    --sp-2d5: 0.625rem;
    --sp-3: 0.75rem;
    --sp-3d5: 0.875rem;
    --sp-4: 1rem;
    --sp-4d5: 1.125rem;
    --sp-5: 1.25rem;
    --sp-5d5: 1.375rem;
    --sp-6: 1.5rem;
    --sp-6d5: 1.625rem;
    --sp-7: 1.75rem;
    --sp-7d5: 1.875rem;
    --sp-8: 2rem;
    --sp-9: 2.25rem;
    --sp-10: 2.5rem;
    --sp-12: 3rem;
    --sp-14: 3.5rem;
  }

  {%- unless settings.heading_size_mode == 'fluid' %}
  @media only screen and (min-width: 750px) {
    :root {
      --font-h0-size: 6rem;
      --font-h1-size: 4rem;
      --font-h2-size: 2.8rem;
      --font-h3-size: 2rem;
      --font-h4-size: 1.6rem;
      --font-h5-size: 1.3rem;
    }
  }
  {%- endunless %}

  {%- for scheme in settings.color_schemes -%}
    {%- assign scheme_classes = scheme_classes | append: ',.color-' | append: scheme.id -%}
  {%- endfor -%}
  {{ scheme_classes | remove_first: ',' }} {
    color: rgb(var(--color-foreground));
    background-color: rgb(var(--color-background));
  }

  {%- for scheme in settings.color_schemes -%}
    {%- assign scheme_id = scheme.id -%}
    {%- assign s = scheme.settings -%}
  .color-{{ scheme_id }} {
    --color-background: {{ s.background.red }}, {{ s.background.green }}, {{ s.background.blue }};
    --color-foreground: {{ s.text.red }}, {{ s.text.green }}, {{ s.text.blue }};
    --color-heading: {{ s.text.red }}, {{ s.text.green }}, {{ s.text.blue }};
    --color-link: {{ s.secondary_button_label.red }}, {{ s.secondary_button_label.green }}, {{ s.secondary_button_label.blue }};
    --color-button: {{ s.button.red }}, {{ s.button.green }}, {{ s.button.blue }};
    --color-button-text: {{ s.button_label.red }}, {{ s.button_label.green }}, {{ s.button_label.blue }};
    --color-shadow: {{ s.shadow.red }}, {{ s.shadow.green }}, {{ s.shadow.blue }};
  }
  {%- endfor -%}

  *,
  *::before,
  *::after {
    box-sizing: inherit;
  }

  html {
    box-sizing: border-box;
    font-size: calc(var(--font-body-scale) * 62.5%);
    height: 100%;
  }

  body {
    min-height: 100%;
    margin: 0;
    font-size: 1.5rem;
    letter-spacing: normal;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
  }

  @media screen and (min-width: 750px) {
    body {
      font-size: 1.6rem;
    }
  }

  {%- if settings.colors_sale_badge_text != blank %}
    {%- comment -%}
      Unset, the sale badge keeps reading its text from the surrounding
      color scheme's background.
    {%- endcomment -%}
    .badge.badge--onsale {
      color: {{ settings.colors_sale_badge_text }};
    }
  {%- endif %}

  {%- if settings.badge_outline %}
    {%- comment -%}
      currentColor rims every badge with its own text color — the only
      way a badge lighter than the image behind it keeps a shape. The
      element selector outranks base.css's single-class border rule.
    {%- endcomment -%}
    span.badge {
      border-color: currentColor;
    }
  {%- endif %}

  {%- if settings.type_navigation_weight == 'bold' and nav_font_bold %}
    {%- comment -%}
      Only the top row takes the extra weight: dropdown product links share
      the header__menu-item class and a list of bold names reads as a slab,
      so the option stays off their tier. The doubled class outweighs
      base.css's single-class weight rule, which loads after this style.
    {%- endcomment -%}
    .header__menu-item.header__menu-item--top {
      font-weight: {{ nav_font_bold.weight }};
    }
  {%- endif %}
{%- endstyle -%}