ge_tag:\n                loading: 'lazy',\n                widths: '37,74,111,120',\n                alt: ''\n            }}\n          <\/span>\n        {% endif %}\n\n        <div class=\"yunta-pdp-bullet__content\">\n          {{ bullet | metafield_tag }}\n        <\/div>\n\n      <\/div>\n    {% endif %}\n  {% endfor %}\n\n<\/div>\n\n<style>\n  .yunta-pdp-bullets {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    width: 100%;\n    max-width: none;\n    margin: 16px 0;\n  }\n\n  .yunta-pdp-bullet {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    width: 100%;\n    max-width: none;\n    font: inherit;\n  }\n\n  .yunta-pdp-icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    width: 37px;\n    height: 37px;\n    flex: 0 0 37px;\n\n    margin-top: 1px;\n  }\n\n  .yunta-pdp-icon img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n  }\n\n  .yunta-pdp-bullet__content {\n    flex: 1 1 auto;\n    min-width: 0;\n    width: auto;\n    max-width: none;\n  }\n\n  .yunta-pdp-bullet__content,\n  .yunta-pdp-bullet__content p,\n  .yunta-pdp-bullet__content .metafield-rich_text_field {\n    margin: 0 !important;\n    padding: 0 !important;\n    width: 100% !important;\n    max-width: none !important;\n\n    font: inherit;\n    color: inherit;\n    line-height: 1.35;\n  }\n\n  .yunta-pdp-bullet__content strong {\n    display: block;\n\n    margin-bottom: 2px;\n\n    color: #D3562A;\n    font-weight: 700;\n    line-height: 1.25;\n  }\n\n  @media screen and (max-width: 749px) {\n    .yunta-pdp-bullets {\n      gap: 9px;\n    }\n\n    .yunta-pdp-bullet {\n      gap: 10px;\n    }\n\n    .yunta-pdp-icon {\n      width: 34px;\n      height: 34px;\n      flex-basis: 34px;\n    }\n  }\n<\/style>"}},"collapsible_description_zhBwUG":{"type":"collapsible_description","settings":{"icon":"none","heading":"Descripción","keep_open":false}},"collapsible_tab_h88AJy":{"type":"collapsible_tab","settings":{"icon":"none","heading":"Especificaciones","content":"","page":"","custom_liquid":"<div class=\"yunta-specs-table\">\n\n  {% assign specs = \n    \"Año|ano,\n    Temporada|temporada,\n    Materiales|materiales,\n    Combustible|combustique,\n    Área de cocción|areas_de_coccion,\n    Seguridad|seguridad,\n    Quemadores|quemadores,\n    Color|color,\n    Modelo|modelo,\n    Tipo de producto|tipo_de_producto,\n    Marca|marca\"\n    | split: \",\"\n  %}\n\n  {% for spec in specs %}\n    {% assign parts = spec | split: \"|\" %}\n    {% assign label = parts[0] | strip %}\n    {% assign key = parts[1] | strip %}\n    {% assign value = product.metafields.custom[key] %}\n\n    {% if value != blank %}\n      <div class=\"yunta-specs-row\">\n        <div class=\"yunta-specs-label\">\n          {{ label }}\n        <\/div>\n\n        <div class=\"yunta-specs-value\">\n          {{ value | metafield_tag }}\n        <\/div>\n      <\/div>\n    {% endif %}\n  {% endfor %}\n\n<\/div>\n\n<style>\n  .yunta-specs-table {\n    width: 100%;\n    border-top: 1px solid rgba(255,255,255,.18);\n  }\n\n  .yunta-specs-row {\n    display: grid;\n    grid-template-columns: minmax(120px, 38%) 1fr;\n    gap: 20px;\n    padding: 12px 0;\n    border-bottom: 1px solid rgba(255,255,255,.12);\n  }\n\n  .yunta-specs-label {\n    font: inherit;\n    font-weight: 600;\n    color: inherit;\n  }\n\n  .yunta-specs-value,\n  .yunta-specs-value p,\n  .yunta-specs-value .metafield-rich_text_field {\n    margin: 0 !important;\n    padding: 0 !important;\n    font: inherit;\n    color: inherit;\n  }\n\n  @media screen and (max-width: 749px) {\n    .yunta-specs-row {\n      grid-template-columns: 1fr;\n      gap: 4px;\n      padding: 10px 0;\n    }\n  }\n<\/style>","keep_open":false}},"custom_liquid_KXzdkK":{"type":"custom_liquid","settings":{"custom_liquid":"{% assign manual = product.metafields.custom.manual_descargable.value %}\n\n{% if manual != blank %}\n\n  <div class=\"yunta-manual\">\n    <div class=\"yunta-manual-title\">\n      DESCARGAR MANUAL\n    <\/div>\n\n    <a\n      href=\"{{ manual.url }}\"\n      target=\"_blank\"\n      class=\"yunta-manual-button\"\n    >\n      ↓ Descargar PDF\n    <\/a>\n  <\/div>\n\n{% endif %}\n\n<style>\n  .yunta-manual {\n    width: 100%;\n    padding: 12px 0 4px;\n  }\n\n  .yunta-manual-title {\n    margin-bottom: 10px;\n    font: inherit;\n    font-size: 11px;\n    font-weight: 500;\n    letter-spacing: .18em;\n    color: inherit;\n  }\n\n  .yunta-manual-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: auto;\n    padding: 9px 16px;\n\n    border: 1px solid #666666;\n    background: transparent;\n    color: #b5b5b5 !important;\n\n    font: inherit;\n    font-size: 12px;\n    font-weight: 600;\n    line-height: 1;\n    text-decoration: none !important;\n    text-transform: uppercase;\n    letter-spacing: .08em;\n\n    transition: all .2s ease;\n  }\n\n  .yunta-manual-button:hover {\n    border-color: #ffffff;\n    background: transparent;\n    color: #ffffff !important;\n  }\n<\/style>"}},"inventory_status":{"type":"inventory_status","settings":{"inventory_threshold":10,"show_inventory_transfer":true,"color_scheme":"accent-3"}},"buy_buttons":{"type":"buy_buttons","settings":{"show_quantity_selector":false,"show_dynamic_checkout":true,"show_gift_card_recipient":false}},"share":{"type":"share","settings":{"share_label":"Compartir"}},"54684625-1615-430d-b322-cfb5af689b94":{"type":"image","settings":{"height":20,"link":""}},"a2f06597-05bf-457d-a1e5-54d6e03ff425":{"type":"sticky_cart","settings":{"show_quantity_selector":false}},"complementary_DVafWw":{"type":"complementary","settings":{"icon":"fire","heading":"Complementa tu Yunta con:","make_collapsible_row":false,"product_list_limit":2,"image_ratio":"square","image_position":"center center","show_vendor":false,"enable_image_fill":true}}},"block_order":["vendor","title","rating","variant_picker","price"