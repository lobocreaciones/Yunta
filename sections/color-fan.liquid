{%- liquid
  assign product = section.settings.product
  assign fan_image = section.settings.image
  if fan_image == blank and product != blank
    assign fan_image = product.featured_image
  endif
  assign count = section.blocks.size
  assign fan_style = section.settings.fan_style

  # Hand-fan geometry: cards pivot below their own box, tops sweeping apart
  # so each shade shows almost whole. The span narrows as cards are added,
  # capped per-card so small counts do not over-separate.
  assign fan_centre = count | minus: 1 | divided_by: 2.0
  assign fan_step = 0
  if count > 1
    assign count_minus_one = count | minus: 1
    assign fan_step = 80.0 | divided_by: count_minus_one | at_most: 18.0
  endif

  # The cards must sit flush behind the picture, so the shared box takes one
  # ratio — the picture's own on adapt, the chosen one otherwise (the picture
  # then covers it) — fitted inside 76% of the square stage.
  assign fan_ratio = 1.0
  case section.settings.image_ratio
    when 'square'
      assign fan_ratio = 1.0
    when 'portrait'
      assign fan_ratio = 0.8
    when 'landscape'
      assign fan_ratio = 1.5
    when 'wide'
      assign fan_ratio = 1.7778
    else
      if fan_image != blank
        assign fan_ratio = fan_image.aspect_ratio
      endif
  endcase
  if fan_ratio >= 1
    assign fan_box_w = 76
    assign fan_box_h = 76.0 | divided_by: fan_ratio | round: 2
  else
    assign fan_box_h = 76
    assign fan_box_w = 76.0 | times: fan_ratio | round: 2
  endif

  # Exact rendered widths for srcset selection: the desktop stage is a fixed
  # pixel setting, so the picture's slot is computable to the pixel; below
  # 750 the stage is fluid at 78vw and the box keeps its share of it.
  assign fan_img_px = section.settings.image_width | times: fan_box_w | divided_by: 100.0 | round
  assign fan_img_vw = 78.0 | times: fan_box_w | divided_by: 100.0 | round: 1
  assign fan_img_sizes = '(min-width: 750px) ' | append: fan_img_px | append: 'px, ' | append: fan_img_vw | append: 'vw'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --fan-card-radius: {{ section.settings.shade_corner_radius }}px;
    --fan-image-radius: {{ section.settings.image_corner_radius }}px;
    --fan-box-width: {{ fan_box_w }}%;
    --fan-box-height: {{ fan_box_h }}%;
    --fan-stage-width: {{ section.settings.image_width }}px;
    --fan-ring-color: {{ section.settings.hover_ring_color }};
  }
{%- endstyle -%}

{{ 'section-color-fan.css' | asset_url | stylesheet_tag }}
<script src="{{ 'color-fan.js' | asset_url }}" defer="defer"></script>

<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="color-fan__header {{ section.settings.heading_alignment }}">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">
            {%- render 'highlight-text',
              hl_input: section.settings.heading,
              hl_style: section.settings.highlight_style,
              hl_enable: section.settings.enable_highlight,
              hl_animateWrap: true -%}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="color-fan__subheading {{ section.settings.subheading_size }}">
            {%- render 'highlight-text',
              hl_input: section.settings.subheading,
              hl_style: section.settings.highlight_style,
              hl_enable: section.settings.enable_highlight,
              hl_animateWrap: true -%}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if count > 0 -%}
      <color-fan class="color-fan color-fan--{{ fan_style }}{% unless section.settings.hover_ring == 'none' %} color-fan--ring color-fan--ring-{{ section.settings.hover_ring }}{% endunless %}" data-fan-trigger="{{ section.settings.fan_trigger }}">
        {%- comment -%}
          The hidden attribute is the FOUC guard for the theme editor: a
          re-rendered section paints one unstyled frame before its stylesheet
          re-applies, and the stage's absolute geometry all lives in CSS. The
          stylesheet's display declaration overrides the attribute.
        {%- endcomment -%}
        {%- if product != blank -%}
          <a href="{{ product.url }}" class="color-fan__stage" aria-label="{{ product.title | escape }}" hidden>
        {%- else -%}
          <div class="color-fan__stage" hidden>
        {%- endif -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign fan_scale_open = 1
              if fan_style == 'spread'
                # Hand fan: linear angles across the span, opening from the
                # centre outward. Every card stays fully opaque — the point
                # of this style is seeing each shade whole. An odd count puts
                # one card at exactly 0°, flush behind the picture — that one
                # scales up instead and rims the picture with its shade.
                assign fan_angle = forloop.index0 | minus: fan_centre | times: fan_step | round: 1
                assign fan_dist = forloop.index0 | minus: fan_centre | abs
                assign fan_delay = fan_dist | times: 90 | round
                assign fan_opacity = 1
                if fan_angle == 0
                  assign fan_scale_open = 1.06
                endif
              else
                # Bloom: one rotation direction, one 10° notch per card,
                # starting at 10° so every shade clears the picture — a card
                # at 0° would hide behind it. A rotated rectangle emerges at
                # both diagonals at once, so the fan reads two-sided by
                # symmetry — no card needs a negative angle.
                assign fan_notch = forloop.index0 | plus: 1
                assign fan_angle = 10 | times: fan_notch
                assign fan_delay = forloop.index0 | times: 60
                assign fan_fade = 0.45 | divided_by: count | times: forloop.index0
                assign fan_opacity = 0.92 | minus: fan_fade | round: 2
                if block.settings.image != blank
                  # A dimmed product shot reads as broken, not as depth.
                  assign fan_opacity = 1
                endif
              endif
            -%}
            <span
              class="color-fan__card"
              aria-hidden="true"
              style="--fan-color: {{ block.settings.color }}; --fan-angle: {{ fan_angle }}deg; --fan-delay: {{ fan_delay }}ms; --fan-opacity: {{ fan_opacity }}; --fan-scale-open: {{ fan_scale_open }};"
              {% if block.settings.label != blank %}data-fan-label="{{ block.settings.label | escape }}"{% endif %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1440 | image_tag:
                  loading: 'lazy',
                  widths: '360, 540, 720, 900, 1080, 1440',
                  sizes: fan_img_sizes,
                  alt: '',
                  is: 'lazy-image'
                }}
              {%- endif -%}
            </span>
          {%- endfor -%}
          <div class="color-fan__media">
            {%- if fan_image != blank -%}
              {{ fan_image | image_url: width: 1440 | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 900, 1080, 1440',
                sizes: fan_img_sizes,
                is: 'lazy-image'
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
        {%- if product != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
        {%- liquid
          # The cards are decorative to assistive tech; the shade names still
          # exist for it as plain text.
          assign shade_names = ''
          for block in section.blocks
            if block.settings.label != blank
              unless shade_names == blank
                assign shade_names = shade_names | append: ', '
              endunless
              assign shade_names = shade_names | append: block.settings.label
            endif
          endfor
        -%}
        {%- if shade_names != blank -%}
          <span class="visually-hidden">{{ shade_names | escape }}</span>
        {%- endif -%}
      </color-fan>
    {%- endif -%}
  </div>
</div>

