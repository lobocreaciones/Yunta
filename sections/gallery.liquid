{%- liquid
  # The gutter belongs to the wrapper while the row stays in the page
  # column, and to the list once it bleeds, because only padding on the
  # scroll container survives past the margin. The heading keeps the column
  # either way.
  assign outer_width = ' page-width'
  assign inner_width = ''
  assign grid_bleed = ''

  # The rail classes. Each breakpoint opts in separately, so a row can scroll on
  # one and stay a grid on the other, and the shared slider class is emitted once
  # for either.
  assign rail_class = ''
  if section.settings.swipe_on_mobile
    assign rail_class = ' slider--tablet'
  endif
  if section.settings.horizontal_scroll
    assign rail_class = rail_class | append: ' slider--tablet-up'
    if section.settings.heading != blank
      assign rail_class = rail_class | append: ' slider--has-controls'
    endif
  endif
  if rail_class != blank
    assign rail_class = ' slider' | append: rail_class
  endif

  if section.settings.full_width
    assign outer_width = ' page-width page-width--full-width'
    assign inner_width = ' page-width'
  elsif section.settings.edge_to_edge
    assign outer_width = ''
    assign inner_width = ' page-width'
    assign grid_bleed = ' slider--bleed'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --color-highlight: {{ section.settings.colors_highlight.red }}, {{ section.settings.colors_highlight.green }}, {{ section.settings.colors_highlight.blue }};
  }

  #Slider-{{ section.id }} {
    --image-height: {{ section.settings.mobile_image_height }}px;
  }

  @media screen and (min-width: 750px) {
    #Slider-{{ section.id }} {
      --grid-horizontal-spacing: {{ section.settings.spacing_images }}px;
      --image-height: {{ section.settings.image_height }}px;
    }
  }
{%- endstyle -%}

<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

{{ 'section-gallery.css' | asset_url | stylesheet_tag }}

<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="{{ outer_width | strip }}">
    <div id="SliderNav-{{ section.id }}" class="title-wrapper{% if section.settings.heading == blank %} title-wrapper--no-heading{% endif %}{{ inner_width }} {{ section.settings.heading_alignment }}">
      <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">
        {%- render 'highlight-text', 
          hl_input: section.settings.heading, 
          hl_style: section.settings.highlight_style,
          hl_enable: section.settings.enable_highlight,
          hl_animateWrap: true -%}
      </{{ section.settings.heading_tag }}>
      {%- comment -%}
        The controls sit in the heading row so they keep the page gutter while the
        row itself runs past it. data-controls on the slider names this container.
        The slider hides them on its own once the row fits on one page.
      {%- endcomment -%}
      {%- if section.settings.horizontal_scroll and section.settings.heading != blank -%}
        <div class="slider-buttons no-js-hidden small-hide">
          <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" disabled="disabled">
            {% render 'icon', icon: 'arrow' %}
          </button>
          <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
            {% render 'icon', icon: 'arrow' %}
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- liquid
      assign columns = section.settings.per_row
      if section.blocks.size < columns
        assign columns = section.blocks.size
      endif
    -%}
    <slider-component data-controls="SliderNav-{{ section.id }}" class="slider-mobile-gutter">
      <ul id="Slider-{{ section.id }}"
        class="gallery gallery--{{ columns }} flex-grid flex-grid--2-col{% if section.settings.columns_mobile == '1' %} flex-grid--1-col-mobile{% endif %}{{ rail_class }}{% if section.settings.apply_overlay %} gallery--contrast{% endif %}{{ grid_bleed }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="flex-grid__item gallery__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}"
          >
            <use-animate class="gallery__card media-wrapper" data-animate="zoom-fade">
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="full-unstyled-link">
                  <span class="visually-hidden">
                    {%- if block.settings.link contains 'instagram.com' -%}
                      View on Instagram
                    {%- else -%}
                      {{ block.settings.heading | default: block.settings.subheading | escape }}
                    {%- endif -%}
                  </span>
                </a>
              {%- endif -%}
              
              {%- if block.settings.image != blank -%}
                <div class="image-animate media" style="--image-position: {{ block.settings.image_position }};">
                  {%- capture sizes -%}(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: columns }}px, (min-width: 750px) {% if columns > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %}, calc(100vw - 3rem)"{%- endcapture -%}
                  {{ block.settings.image | image_url: width: 2400 | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: '375, 750, 1100, 1500, 2000, 2400',
                    is: 'lazy-image'
                  }}
                </div>
              {%- else -%}
                <div class="media media--placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder' }}
                </div>
              {%- endif -%}
              
              {%- if block.settings.heading != blank or block.settings.subheading != blank -%}
                <div class="gallery__overlay gallery__overlay--{{ block.settings.text_box_position }}">
                  <div class="gallery__text">
                    <div class="overlay-text__wrapper">
                      {%- if block.settings.subheading != blank -%}
                        <p class="overlay-text__subheading {{ block.settings.subheading_size }}">
                          {%- render 'highlight-text', 
                            hl_input: block.settings.subheading, 
                            hl_style: block.settings.highlight_style,
                            hl_enable: block.settings.enable_highlight,
                            hl_animateWrap: true -%}
                        </p>
                      {%- endif -%}
                      {%- if block.settings.heading != blank -%}
                        <p class="overlay-text__heading {{ block.settings.heading_size }}">
                          {%- render 'highlight-text', 
                            hl_input: block.settings.heading, 
                            hl_style: block.settings.highlight_style,
                            hl_enable: block.settings.enable_highlight,
                            hl_animateWrap: true -%}
                        </p>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </use-animate>
          </li>
        {%- endfor -%}
      </ul>
    </slider-component>
  </div>
</div>

