						PLACE_PHOTO_BACK_ARIA_LABEL: {{ 'sections.store_locator.gmap_strings.place_photo_back_aria_label' | t | json }},
						PLACE_PHOTO_NEXT_ARIA_LABEL: {{ 'sections.store_locator.gmap_strings.place_photo_next_aria_label' | t | json }},
						PLACE_PHOTO_PREV_ARIA_LABEL: {{ 'sections.store_locator.gmap_strings.place_photo_prev_aria_label' | t | json }},
						PLACE_PHOTO_TILE_ARIA_LABEL: {{ 'sections.store_locator.gmap_strings.place_photo_tile_aria_label' | t | json }},
						PLACE_RATING_ARIA_LABEL: {{ 'sections.store_locator.gmap_strings.place_rating_aria_label' | t | json }},
						PLACE_REVIEWS_AUTHOR_PHOTO_ALT: {{ 'sections.store_locator.gmap_strings.place_reviews_author_photo_alt' | t | json }},
						PLACE_REVIEWS_MORE: {{ 'sections.store_locator.gmap_strings.place_reviews_more' | t | json }},
