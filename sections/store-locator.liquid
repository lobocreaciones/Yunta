{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

	#shopify-section-{{ section.id }} .media-wrapper {
		box-shadow: 0px 0.5rem 4.5rem 0px rgb(0 0 0 / 10%);
    {% unless section.settings.full_width %}border-radius: 0.6rem;{% endunless %}
	}

	gmpx-store-locator {
		width: 100%;
		height: 100%;
		--gmpx-color-surface: {{ section.settings.colors_overlay | default: '#fff' }};
		--gmpx-color-on-surface: {{ section.settings.colors_text | default: '#212121' }};
		--gmpx-color-on-surface-variant: {{ section.settings.colors_text | default: '#757575' }};
		--gmpx-color-primary: {{ section.settings.colors_button_label | default: '#1967d2' }};
		--gmpx-color-outline: {{ section.settings.colors_border | default: '#e0e0e0' }};
		--gmpx-fixed-panel-width-row-layout: 31em;
		--gmpx-fixed-panel-height-column-layout: 65%;
		--gmpx-font-size-base: 1.1rem;
		--gmpx-hours-color-open: #188038;
		--gmpx-hours-color-closed: #d50000;
		--gmpx-rating-color: #ffb300;
		--gmpx-rating-color-empty: #e0e0e0;
	}
{%- endstyle -%}

{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full-width{% endif %}">
		<div class="media-wrapper">
			<div class="media media--{{ section.settings.image_ratio }} media-mobile--{{ section.settings.mobile_image_ratio }}">
				{%- assign map_lang = section.settings.map_language | strip -%}
				{%- if map_lang == 'auto' -%}
					{%- assign map_lang = request.locale.iso_code | split: '-' | first -%}
				{%- endif -%}
				<script>
					window.__GMAP_LIBRARY_URL__ = {{ 'googlemaps-extended-component-library.js' | asset_url | json }};
					window.__GMAP_STRINGS__ = {
						LOCATOR_BACK_BUTTON_CTA: {{ 'sections.store_locator.gmap_strings.locator_back_button_cta' | t | json }},
						LOCATOR_DIRECTIONS_BUTTON_LABEL: {{ 'sections.store_locator.gmap_strings.locator_directions_button_label' | t | json }},
						LOCATOR_LIST_HEADER: {{ 'sections.store_locator.gmap_strings.locator_list_header' | t | json }},
						LOCATOR_LIST_SUBHEADING: {{ 'sections.store_locator.gmap_strings.locator_list_subheading' | t | json }},
						LOCATOR_LIST_SUBHEADING_WITH_SEARCH: {{ 'sections.store_locator.gmap_strings.locator_list_subheading_with_search' | t | json }},
						LOCATOR_SEARCH_LOCATION_MARKER_TITLE: {{ 'sections.store_locator.gmap_strings.locator_search_location_marker_title' | t | json }},
						LOCATOR_SEARCH_PROMPT: {{ 'sections.store_locator.gmap_strings.locator_search_prompt' | t | json }},
						LOCATOR_VIEW_DETAILS_CTA: {{ 'sections.store_locator.gmap_strings.locator_view_details_cta' | t | json }},
						PLACE_CLEAR_ARIA_LABEL: {{ 'sections.store_locator.gmap_strings.place_clear_aria_label' | t | json }},
						PLACE_CLOSED: {{ 'sections.store_locator.gmap_strings.place_closed' | t | json }},
						PLACE_CLOSED_PERMANENTLY: {{ 'sections.store_locator.gmap_strings.place_closed_permanently' | t | json }},
						PLACE_CLOSED_TEMPORARILY: {{ 'sections.store_locator.gmap_strings.place_closed_temporarily' | t | json }},
						PLACE_CLOSES: {{ 'sections.store_locator.gmap_strings.place_closes' | t | json }},
						PLACE_HAS_DELIVERY: {{ 'sections.store_locator.gmap_strings.place_has_delivery' | t | json }},
						PLACE_HAS_DINE_IN: {{ 'sections.store_locator.gmap_strings.place_has_dine_in' | t | json }},
						PLACE_HAS_TAKEOUT: {{ 'sections.store_locator.gmap_strings.place_has_takeout' | t | json }},
						PLACE_NO_DELIVERY: {{ 'sections.store_locator.gmap_strings.place_no_delivery' | t | json }},
						PLACE_NO_DINE_IN: {{ 'sections.store_locator.gmap_strings.place_no_dine_in' | t | json }},
						PLACE_NO_TAKEOUT: {{ 'sections.store_locator.gmap_strings.place_no_takeout' | t | json }},
						PLACE_OPEN_ALWAYS: {{ 'sections.store_locator.gmap_strings.place_open_always' | t | json }},
						PLACE_OPEN_NOW: {{ 'sections.store_locator.gmap_strings.place_open_now' | t | json }},
