{%- liquid
  # One alignment authority for the tab row, both breakpoints. The leading grid
  # track carries it on desktop: centred keeps the symmetric 1fr pair; aligned
  # ends swap the near track for the page gutter when the grid bleeds (it spans
  # the viewport, so the column edge must be spelled out) or for nothing when
  # the grid already sits in the page column. Labels only render from 990px up,
  # so the 5rem gutter value is the only one the formula needs.
  assign tab_style = section.settings.tab_style | default: 'underline'
  assign tab_alignment = section.settings.tab_alignment | default: 'center'
  assign tabs_lead = '1fr'
  assign tabs_tail = '1fr'
  if section.settings.edge_to_edge
    assign tabs_gutter = 'calc((100% - min(100%, var(--page-width))) / 2 + 5rem)'
  else
    assign tabs_gutter = '0px'
  endif
  if tab_alignment == 'left'
    assign tabs_lead = tabs_gutter
  elsif tab_alignment == 'right'
    assign tabs_tail = tabs_gutter
  endif

  # Whether the controls actually show above the row on desktop. They are only
  # rendered with horizontal scrolling on, and a row of four or fewer fits
  # without scrolling so they are hidden again from 990px up. CSS cannot ask
  # this — the buttons stay in the DOM when hidden, so :has() would still match.
  assign desktop_controls = false
  if section.settings.horizontal_scroll and section.settings.products_to_show > 4
    assign desktop_controls = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --image-position: {{ section.settings.image_position }};
    --color-highlight: {{ section.settings.colors_highlight.red }}, {{ section.settings.colors_highlight.green }}, {{ section.settings.colors_highlight.blue }};
  }

  #shopify-section-{{ section.id }} .tabs-grid {
    display: grid;
    grid-template-columns: {{ tabs_lead }} repeat({{ section.blocks.size }}, auto) {{ tabs_tail }};
    grid-template-rows: auto 1fr;
    column-gap: 0;
  }

  /*
    display: contents, not a subgrid: WebKit before 18.4 ignores grid display
    on <details> entirely and keeps the UA disclosure layout, which piles every
    label into the flexible lead column. Stepped aside, the summary and the
    panel place themselves as grid items of .tabs-grid directly.
  */
  #shopify-section-{{ section.id }} .tabs-grid > details {
    display: contents;
  }

  #shopify-section-{{ section.id }} .tabs-grid .tab-label {
    grid-row: 1;
    grid-column: calc(var(--tab-index) + 1) / span 1;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: 1.2rem 2.4rem;
    cursor: pointer;
    list-style: none;
    text-align: center;
    color: rgba(var(--color-foreground), 0.5);
    font-weight: 500;
    transition: color var(--duration-default) ease;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .tabs-grid .tab-label::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .tabs-grid .tab-label::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: rgb(var(--color-highlight));
    transition: width var(--duration-default) ease, opacity var(--duration-default) ease;
  }

  /* Hover previews the tab's own selected anatomy at reduced strength — the
     underline shows its faint bar, the pill its faint fill — so hover always
     answers what clicking gives. */
  @media screen and (hover: hover) {
    #shopify-section-{{ section.id }} .tabs-grid .tab-label:hover {
      color: rgba(var(--color-foreground), 0.8);
    }

    {%- if tab_style == 'underline' -%}
      #shopify-section-{{ section.id }} .tabs-grid > details:not([open]) .tab-label:hover::after {
        width: 3.2rem;
        opacity: 0.45;
      }
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .tabs-grid > details[open] .tab-label {
    color: rgb(var(--color-foreground));
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .tabs-grid > details[open] .tab-label::after {
    width: 3.2rem;
  }

  {%- if tab_style == 'pill' -%}
    /* The quiet pill: only the open tab takes the fill, borrowed from the
       product options' checked state — foreground on background is contrast-
       safe on any palette, and the radius rides the button token so the shape
       follows the store's personality. Paint only: the paddings match the
       underline style, so switching styles never moves a label. The fill is
       the underline's ::after repurposed as an inset layer — the pill reads
       slimmer than the hit area without shrinking the hit area itself. The
       weight stays constant because the fill carries selection. */
    #shopify-section-{{ section.id }} .tabs-grid .tab-label {
      border-radius: var(--button-radius);
    }

    #shopify-section-{{ section.id }} .tabs-grid .tab-label::after {
      inset: 0.5rem 0.4rem;
      width: auto;
      height: auto;
      transform: none;
      background: transparent;
      border-radius: var(--button-radius);
      transition: background-color var(--duration-default) ease;
      z-index: -1;
    }

    #shopify-section-{{ section.id }} .tabs-grid > details[open] .tab-label {
      color: rgb(var(--color-background));
      font-weight: 500;
    }

    #shopify-section-{{ section.id }} .tabs-grid > details[open] .tab-label::after {
      background-color: rgb(var(--color-foreground));
      width: auto;
    }

    @media screen and (hover: hover) {
      #shopify-section-{{ section.id }} .tabs-grid > details:not([open]) .tab-label:hover::after {
        background-color: rgba(var(--color-foreground), 0.07);
        width: auto;
        opacity: 1;
      }
    }
  {%- endif -%}

  /*
    The panel's box styling lives on .tab-content, not on ::details-content:
    Safari before 18.4 has no ::details-content, and there the div itself is
    the details' grid item. Where the pseudo exists, display: contents steps
    it aside so the div is the grid item everywhere. The :not([open]) hide
    stays explicit — display: contents also disables the UA's own
    content-visibility hiding of closed panels.
  */
  #shopify-section-{{ section.id }} .tabs-grid > details::details-content {
    display: contents;
  }

  #shopify-section-{{ section.id }} .tabs-grid > details > .tab-content {
    grid-row: 2;
    grid-column: 1 / -1;
    padding-top: 3rem;
  }

  #shopify-section-{{ section.id }} .tabs-grid > details:not([open]) > .tab-content {
    display: none;
  }

  {%- if tab_style == 'underline' and tab_alignment == 'left' -%}
    /* The outer label sheds its outer padding so the text lands on the column
       edge, and the underline follows the text start rather than the cell
       centre. */
    #shopify-section-{{ section.id }} .tabs-grid > details:first-child .tab-label {
      padding-inline-start: 0;
    }

    #shopify-section-{{ section.id }} .tabs-grid .tab-label::after {
      left: auto;
      transform: none;
      inset-inline-start: 2.4rem;
    }

    #shopify-section-{{ section.id }} .tabs-grid > details:first-child .tab-label::after {
      inset-inline-start: 0;
    }
  {%- elsif tab_style == 'underline' and tab_alignment == 'right' -%}
    #shopify-section-{{ section.id }} .tabs-grid > details:last-child .tab-label {
      padding-inline-end: 0;
    }

    #shopify-section-{{ section.id }} .tabs-grid .tab-label::after {
      left: auto;
      transform: none;
      inset-inline-end: 2.4rem;
    }

    #shopify-section-{{ section.id }} .tabs-grid > details:last-child .tab-label::after {
      inset-inline-end: 0;
    }
  {%- endif -%}

  @media screen and (min-width: 990px) {
    /* .tabs-gutter marks the section's own row — the quick-view galleries
       nested inside the product cards carry .slider-mobile-gutter and
       .slider-buttons of their own. */
    #shopify-section-{{ section.id }} .tabs-gutter {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    #shopify-section-{{ section.id }} .tabs-gutter > .slider-buttons {
      order: 0;
      position: static !important;
      display: flex;
      justify-content: flex-end;
      gap: 0.5rem;
      margin-bottom: 0;
    }

    #shopify-section-{{ section.id }} .tabs-gutter > .product-grid {
      order: 1;
    }

    {%- if desktop_controls -%}
      /* The controls sit between the labels and the row and carry that
         separation themselves; without them the panel owns the whole gap. */
      #shopify-section-{{ section.id }} .tabs-grid > details > .tab-content {
        padding-top: 0.5rem;
      }
    {%- endif -%}

    {%- if section.settings.edge_to_edge -%}
      /* The controls sit above a row that now reaches the screen edge; the
         gutter keeps them on the page column with it. */
      #shopify-section-{{ section.id }} .tabs-gutter > .slider-buttons {
        padding-inline-end: calc((100% - min(100%, var(--page-width))) / 2 + 5rem);
      }
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .fake-tabs-mobile {
    display: none;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .fake-tabs-mobile {
      display: block;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      margin-bottom: 2rem;
      {% if tab_style == 'underline' %}border-bottom: 1px solid rgba(var(--color-foreground), 0.1);{% endif %}
    }

    #shopify-section-{{ section.id }} .fake-tabs-mobile::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .fake-tabs-container {
      display: flex;
      gap: 0;
      min-width: min-content;
      {%- if tab_alignment == 'center' -%}
        width: fit-content;
        margin-inline: auto;
      {%- elsif tab_alignment == 'right' -%}
        width: fit-content;
        margin-inline-start: auto;
      {%- endif -%}
    }

    {%- if tab_style == 'underline' and tab_alignment == 'left' -%}
      #shopify-section-{{ section.id }} .fake-tab-item:first-child {
        padding-inline-start: 0;
      }

      #shopify-section-{{ section.id }} .fake-tab-item::after {
        left: auto;
        transform: none;
        inset-inline-start: 1.5rem;
      }

      #shopify-section-{{ section.id }} .fake-tab-item:first-child::after {
        inset-inline-start: 0;
      }
    {%- elsif tab_style == 'underline' and tab_alignment == 'right' -%}
      #shopify-section-{{ section.id }} .fake-tab-item:last-child {
        padding-inline-end: 0;
      }

      #shopify-section-{{ section.id }} .fake-tab-item::after {
        left: auto;
        transform: none;
        inset-inline-end: 1.5rem;
      }

      #shopify-section-{{ section.id }} .fake-tab-item:last-child::after {
        inset-inline-end: 0;
      }
    {%- endif -%}

    /* The same selected-tab language as the desktop labels: quiet weight
       pair, centred underline, nothing else — one control, one voice. The
       resets neutralise the button element the strip needs for the keyboard. */
    #shopify-section-{{ section.id }} .fake-tab-item {
      flex: 0 0 auto;
      position: relative;
      padding: 1rem 1.5rem;
      border: 0;
      background: none;
      font: inherit;
      color: rgba(var(--color-foreground), 0.5);
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
      transition: color var(--duration-default) ease;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    #shopify-section-{{ section.id }} .fake-tab-item::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 2px;
      background: rgb(var(--color-highlight));
      transition: width var(--duration-default) ease, opacity var(--duration-default) ease;
    }

    #shopify-section-{{ section.id }} .fake-tab-item.active {
      color: rgb(var(--color-foreground));
      font-weight: 600;
    }

    #shopify-section-{{ section.id }} .fake-tab-item.active::after {
      width: 3.2rem;
    }

    #shopify-section-{{ section.id }} .fake-tab-item:active {
      opacity: 0.7;
    }

    {%- if tab_style == 'pill' -%}
      #shopify-section-{{ section.id }} .fake-tab-item {
        border-radius: var(--button-radius);
        z-index: 0;
      }

      #shopify-section-{{ section.id }} .fake-tab-item::after {
        inset: 0.4rem 0.3rem;
        width: auto;
        height: auto;
        transform: none;
        background: transparent;
        border-radius: var(--button-radius);
        transition: background-color var(--duration-default) ease;
        z-index: -1;
      }

      #shopify-section-{{ section.id }} .fake-tab-item.active {
        color: rgb(var(--color-background));
        font-weight: 500;
      }

      #shopify-section-{{ section.id }} .fake-tab-item.active::after {
        background-color: rgb(var(--color-foreground));
        width: auto;
      }
    {%- endif -%}

    #shopify-section-{{ section.id }} .tabs-grid .tab-label {
      display: none;
    }

    #shopify-section-{{ section.id }} .tabs-grid {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
    }

    #shopify-section-{{ section.id }} .tabs-grid > details > .tab-content {
      grid-row: 1;
      grid-column: 1;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .tabs-grid,
    #shopify-section-{{ section.id }} .tabs-grid > details,
    #shopify-section-{{ section.id }} .tab-content,
    #shopify-section-{{ section.id }} .slider-mobile-gutter {
      min-width: 0;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .tab-content {
      overflow: hidden;
    }

    {%- unless section.settings.edge_to_edge -%}
      /* With the rail off, the wrapper owns the scroll and the one-up card is
         sized off the viewport to reach the screen edge. With it on, the
         shared slider owns both: the list scrolls and the card follows the
         page column. */
      #shopify-section-{{ section.id }} .slider-mobile-gutter {
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
      }

      #shopify-section-{{ section.id }} .product-grid {
        display: flex;
        flex-wrap: nowrap;
      }

      #shopify-section-{{ section.id }} .product-grid.flex-grid--1-col-mobile .flex-grid__item {
        width: calc(100vw - var(--page-width-margin) * 2);
      }
    {%- endunless -%}
  }

  /* The strip renders below 990 but the pointer can still be a mouse there. */
  @media screen and (max-width: 989px) and (hover: hover) {
    #shopify-section-{{ section.id }} .fake-tab-item:not(.active):hover {
      color: rgba(var(--color-foreground), 0.8);
    }

    {%- if tab_style == 'underline' -%}
      #shopify-section-{{ section.id }} .fake-tab-item:not(.active):hover::after {
        width: 3.2rem;
        opacity: 0.45;
      }
    {%- else -%}
      #shopify-section-{{ section.id }} .fake-tab-item:not(.active):hover::after {
        background-color: rgba(var(--color-foreground), 0.07);
      }
    {%- endif -%}
  }
{%- endstyle -%}

<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if settings.quick_view_enabled and section.settings.enable_quick_view -%}
  <link rel="stylesheet" href="{{ 'section-main-product.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'component-deferred-media.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>

{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="page-width">
    <div class="title-wrapper{% if section.settings.heading == blank %} title-wrapper--no-heading{% endif %} {{ section.settings.heading_alignment }}">
      <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">
        {%- render 'highlight-text', 
          hl_input: section.settings.heading, 
          hl_style: section.settings.highlight_style,
          hl_enable: section.settings.enable_highlight,
          hl_animateWrap: true -%}
      </{{ section.settings.heading_tag }}>
    </div>
  </div>

  {%- liquid
    # The gutter belongs to the wrapper while the row stays in the page column,
    # and to the list once it bleeds, because only padding on the scroll
    # container survives past the margin. The tab labels keep the wrapper in
    # both modes: the grid centres them between its outer 1fr tracks, so the
    # column only bounds how wide the label row may grow.
    assign wrapper_width = ' page-width'
    assign grid_bleed = ''
    if section.settings.edge_to_edge
      assign wrapper_width = ''
      assign grid_bleed = ' slider--bleed'
    endif
  -%}

  {%- if section.blocks.size == 1 -%}
    {%- assign block = section.blocks.first -%}
    {%- assign collection = block.settings.collection -%}

    {%- liquid
      assign products_to_display = collection.all_products_count

      if collection.all_products_count > section.settings.products_to_show
        assign products_to_display = section.settings.products_to_show
      endif

      assign class_slider = 'slider'
      if section.settings.swipe_on_mobile
        assign class_slider = class_slider | append: ' slider--tablet'
      endif
      assign class_grid_2_col_tablet = 'flex-grid--2-col-tablet'
      assign class_grid_3_col_tablet = 'flex-grid--3-col-tablet'
      assign class_grid_3_col_desktop = 'flex-grid--3-col-desktop'
      assign class_grid_4_col_desktop = 'flex-grid--4-col-desktop'
      assign disable_image_click = false

      if section.settings.horizontal_scroll
        assign class_grid_2_col_tablet = 'flex-grid--2p3-col-tablet'
        assign class_grid_3_col_tablet = 'flex-grid--3p3-col-tablet'
        assign class_grid_3_col_desktop = 'flex-grid--3p3-col-desktop'
        assign class_grid_4_col_desktop = 'flex-grid--4p3-col-desktop'
        assign class_slider = class_slider | append: ' slider--tablet-up slider--has-controls'
        if section.settings.products_to_show > 4 and section.settings.enable_drag
          assign disable_image_click = true
          assign class_slider = class_slider | append: ' cursor--drag'
        endif
      endif
    %}

    <div class="slider-mobile-gutter tabs-gutter{{ wrapper_width }}">
      <ul id="Slider-{{ section.id }}"
        class="product-grid flex-grid flex-grid--rigid{% if section.settings.columns_mobile == '1' %} flex-grid--1-col-mobile{% endif %} flex-grid--2-col{% if collection == blank or products_to_display == 4 and section.settings.swipe_on_mobile == false %} {{ class_grid_2_col_tablet }} {{ class_grid_4_col_desktop }}{% else %} {{ class_grid_3_col_tablet }}{% if products_to_display == 6 %} {{ class_grid_3_col_desktop }}{% else %} {{ class_grid_4_col_desktop }}{% endif %}{% endif %}{% if collection.all_products_count > 2 and section.settings.products_to_show > 2 %} {{ class_slider }}{% endif %}{% if collection == blank %} {{ class_slider }}{% endif %}{{ grid_bleed }}"
        role="list"{% if section.settings.horizontal_scroll %} is="scroll-snap-slider" data-draggable="{{ section.settings.enable_drag }}"{% endif %}
      >
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <li id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="flex-grid__item{% if collection.all_products_count > 2 and section.settings.swipe_on_mobile and section.settings.products_to_show > 2 %} slider__slide{% endif %}"
          >
            {% render 'card-product',
              card_product: product,
              card_collection: collection,
              media_size: section.settings.image_ratio,
              show_secondary_image: section.settings.show_secondary_image,
              show_quick_buy: section.settings.show_quick_buy,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              enable_quick_view: section.settings.enable_quick_view,
              enable_color_swatches: section.settings.enable_color_swatches,
              enable_countdown: section.settings.enable_countdown,
              enable_image_fill: section.settings.enable_image_fill,
              show_product_highlights: section.settings.show_product_highlights,
              disable_image_click: disable_image_click
            %}
          </li>
        {%- else -%}
          {%- for i in (1..4) -%}
            <li class="flex-grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}">
              {% render 'card-product-placeholder', media_size: section.settings.image_ratio %}
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
      {% if section.settings.horizontal_scroll %}
        <div class="slider-buttons no-js-hidden small-hide{% if section.settings.products_to_show <= 4 %} large-up-hide{% if section.settings.products_to_show <= 3 %} medium-hide{% endif %}{% endif %}">
          <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" disabled="disabled">
            {% render 'icon', icon: 'arrow' %}
          </button>
          <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
            {% render 'icon', icon: 'arrow' %}
          </button>
        </div>
      {% endif %}
    </div>

    {%- if section.settings.show_view_all and collection.all_products_count > section.settings.products_to_show -%}
      <div class="view-all center page-width">
        <a href="{{ collection.url }}"
          class="button"
          aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: collection.title }}"
        >
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
  {%- elsif section.blocks.size > 1 -%}
    <tabbed-collections>
      <div class="fake-tabs-mobile page-width">
        <div class="fake-tabs-container">
          {%- for block in section.blocks -%}
            {%- liquid
              assign collection = block.settings.collection
              assign tab_label = block.settings.tab_label
              if tab_label == blank and collection != blank
                assign tab_label = collection.title
              elsif tab_label == blank
                assign tab_label = 'Tab ' | append: forloop.index
              endif
            -%}
            <button
              type="button"
              class="fake-tab-item{% if forloop.first %} active{% endif %}"
              data-tab-index="{{ forloop.index }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              {{ tab_label }}
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="tabs-grid{{ wrapper_width }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign tab_label = block.settings.tab_label
          if tab_label == blank and collection != blank
            assign tab_label = collection.title
          elsif tab_label == blank
            assign tab_label = 'Tab ' | append: forloop.index
          endif

          assign products_to_display = collection.all_products_count
          if collection.all_products_count > section.settings.products_to_show
            assign products_to_display = section.settings.products_to_show
          endif

          assign class_slider = 'slider'
          if section.settings.swipe_on_mobile
            assign class_slider = class_slider | append: ' slider--tablet'
          endif
          assign class_grid_2_col_tablet = 'flex-grid--2-col-tablet'
          assign class_grid_3_col_tablet = 'flex-grid--3-col-tablet'
          assign class_grid_3_col_desktop = 'flex-grid--3-col-desktop'
          assign class_grid_4_col_desktop = 'flex-grid--4-col-desktop'
          assign disable_image_click = false

          if section.settings.horizontal_scroll
            assign class_grid_2_col_tablet = 'flex-grid--2p3-col-tablet'
            assign class_grid_3_col_tablet = 'flex-grid--3p3-col-tablet'
            assign class_grid_3_col_desktop = 'flex-grid--3p3-col-desktop'
            assign class_grid_4_col_desktop = 'flex-grid--4p3-col-desktop'
            assign class_slider = class_slider | append: ' slider--tablet-up slider--has-controls'
            if section.settings.products_to_show > 4 and section.settings.enable_drag
              assign disable_image_click = true
              assign class_slider = class_slider | append: ' cursor--drag'
            endif
          endif
        %}

        <details class="tab-item" 
                 name="tabbed-collection-{{ section.id }}" 
                 style="--tab-index: {{ forloop.index }}"
                 {% if forloop.first %}open{% endif %}
                 {{ block.shopify_attributes }}>
          <summary class="tab-label">{{ tab_label }}</summary>
            
          <div class="tab-content">
            <div class="slider-mobile-gutter tabs-gutter">
              <ul id="Slider-{{ section.id }}-{{ block.id }}"
                class="product-grid flex-grid flex-grid--rigid{% if section.settings.columns_mobile == '1' %} flex-grid--1-col-mobile{% endif %} flex-grid--2-col{% if collection == blank or products_to_display == 4 and section.settings.swipe_on_mobile == false %} {{ class_grid_2_col_tablet }} {{ class_grid_4_col_desktop }}{% else %} {{ class_grid_3_col_tablet }}{% if products_to_display == 6 %} {{ class_grid_3_col_desktop }}{% else %} {{ class_grid_4_col_desktop }}{% endif %}{% endif %}{% if collection.all_products_count > 2 and section.settings.products_to_show > 2 %} {{ class_slider }}{% endif %}{% if collection == blank %} {{ class_slider }}{% endif %}{{ grid_bleed }}"
                role="list"{% if section.settings.horizontal_scroll %} is="scroll-snap-slider" data-draggable="{{ section.settings.enable_drag }}"{% endif %}
              >
                {%- for product in collection.products limit: section.settings.products_to_show -%}
                  <li id="Slide-{{ section.id }}-{{ block.id }}-{{ forloop.index }}"
                    class="flex-grid__item{% if collection.all_products_count > 2 and section.settings.swipe_on_mobile and section.settings.products_to_show > 2 %} slider__slide{% endif %}"
                  >
                    {% render 'card-product',
                      card_product: product,
                      card_collection: collection,
                      media_size: section.settings.image_ratio,
                      show_secondary_image: section.settings.show_secondary_image,
                      show_quick_buy: section.settings.show_quick_buy,
                      show_vendor: section.settings.show_vendor,
                      show_rating: section.settings.show_rating,
                      enable_quick_view: section.settings.enable_quick_view,
                      enable_color_swatches: section.settings.enable_color_swatches,
                      enable_countdown: section.settings.enable_countdown,
                      enable_image_fill: section.settings.enable_image_fill,
                      show_product_highlights: section.settings.show_product_highlights,
                      disable_image_click: disable_image_click
                    %}
                  </li>
                {%- else -%}
                  {%- for i in (1..4) -%}
                    <li class="flex-grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}">
                      {% render 'card-product-placeholder', media_size: section.settings.image_ratio %}
                    </li>
                  {%- endfor -%}
                {%- endfor -%}
              </ul>
              {% if section.settings.horizontal_scroll %}
                <div class="slider-buttons no-js-hidden small-hide{% if section.settings.products_to_show <= 4 %} large-up-hide{% if section.settings.products_to_show <= 3 %} medium-hide{% endif %}{% endif %}">
                  <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" disabled="disabled">
                    {% render 'icon', icon: 'arrow' %}
                  </button>
                  <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
                    {% render 'icon', icon: 'arrow' %}
                  </button>
                </div>
              {% endif %}
            </div>

            {%- if section.settings.show_view_all and collection.all_products_count > section.settings.products_to_show -%}
              <div class="view-all center page-width">
                <a href="{{ collection.url }}"
                  class="button"
                  aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: collection.title }}"
                >
                  {{ 'sections.featured_collection.view_all' | t }}
                </a>
              </div>
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
      </div>
    </tabbed-collections>
  {%- else -%}
    <div class="placeholder-content page-width">
      <p>Add collection blocks to display tabbed collections.</p>
    </div>
  {%- endif -%}
</div>

